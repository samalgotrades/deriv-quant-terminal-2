{
  "name": "deriv-quant-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Professional Deriv synthetic market intelligence MVP.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dqt/web",
    "dev:web": "npm run dev --workspace @dqt/web",
    "dev:api": "npm run dev --workspace @dqt/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
